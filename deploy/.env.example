# 复制为 .env 后修改
# cp .env.example .env

# 你的域名（用于 Nginx 与证书）
MMM_DOMAIN=api.example.com

# 生产环境关闭演示加速
NODE_ENV=production
DEMO_FAST_EXIT=0
REQUIRE_SIGNATURE=0

# 收款多签地址（TRON）
TREASURY_ADDRESS=TYourTreasuryAddressHere

# 链监听（可选，与 node1 同机部署时）
RAFT_LEADER_API=http://127.0.0.1:3001
# DEMO_AUTO_CONFIRM=0
# TRONGRID_API_KEY=

# 网关上游（单机 Docker 默认即可）
UPSTREAM_NODES=http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
GATEWAY_PORT=8443
