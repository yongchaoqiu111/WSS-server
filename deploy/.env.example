# 复制为 .env 后修改
# cp .env.example .env

# 主域名（证书文件名、install 提示用）
MMM_DOMAIN=book26.top

# 全部网关域名，空格分隔（Nginx server_name + Certbot）
MMM_DOMAINS=book26.top news16.top

# 网关内置默认域名列表（逗号分隔，/api/domains）
GATEWAY_DOMAINS=book26.top,news16.top

CERTBOT_EMAIL=admin@book26.top

NODE_ENV=production
DEMO_FAST_EXIT=0
REQUIRE_SIGNATURE=0

TREASURY_ADDRESS=TYourTreasuryAddressHere

# 主网出场池收款地址（三档共用，付清打款任务打到此地址）
POOL_EXIT_ADDRESS=TRjvctzrc5WcEeu2UrT8mV5H6zW8dCgimR

RAFT_LEADER_API=http://127.0.0.1:3001

UPSTREAM_NODES=http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
GATEWAY_PORT=8443
